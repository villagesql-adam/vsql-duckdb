INSTALL EXTENSION vsql_duckdb;
#
# Without .max_result_length(), CREATE TABLE ... AS SELECT sizes the
# materialized column from the width of the SQL text passed to
# duckdb_query, not from the result it can actually produce. A short
# query that produces a long result used to fail with
# ER_DATA_TOO_LONG here; declaring .max_result_length(kQueryBufferSize)
# sizes the column to hold the full result instead.
#
CREATE TABLE materialized_query AS
SELECT duckdb_query('SELECT repeat(''x'', 5000) AS s') AS v;
SHOW CREATE TABLE materialized_query;
Table	Create Table
materialized_query	CREATE TABLE `materialized_query` (
  `v` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT LENGTH(v) > 5000 AS result_not_truncated FROM materialized_query;
result_not_truncated
1
DROP TABLE materialized_query;
UNINSTALL EXTENSION vsql_duckdb;
