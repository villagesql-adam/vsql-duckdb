INSTALL EXTENSION vsql_duckdb;
#
# Local file access is off, so nothing here can be read from disk
#
SELECT JSON_EXTRACT(duckdb_status(), '$.allow_local_files') AS local_files;
local_files
false
#
# Reading the file over HTTP returns both records
#
SELECT duckdb_query(@all) AS records;
records
[{"city":"bergen","n":5},{"city":"oslo","n":10}]
#
# DuckDB aggregates over the fetched file
#
SELECT duckdb_scalar(@total) AS total;
total
15
#
# HTTPS works with local files off. The test server speaks plain HTTP,
# so the TLS handshake fails; what matters is that the request got as far
# as the handshake, which needs the CA bundle
#
SELECT duckdb_scalar(@tls) AS tls;
ERROR HY000: VDF error in function 'duckdb_scalar': vsql_duckdb: IO Error: <TLS handshake failed>
#
# The server shuts down cleanly with the extension holding HTTP clients
#
# restart
Pattern "got signal" not found
UNINSTALL EXTENSION vsql_duckdb;
